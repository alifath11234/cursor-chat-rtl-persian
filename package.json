{
  "name": "cursor-chat-rtl-persian",
  "displayName": "Cursor Chat RTL — Persian",
  "description": "RTL support for Cursor Agent chat (Persian, Arabic, Hebrew). Two toolbar toggles: ⇄ for chat text, code icon for code blocks & Monaco in chat. Patches Cursor workbench.",
  "version": "1.1.0",
  "publisher": "alifath",
  "author": {
    "name": "ALI FATHNEJAT",
    "email": ""
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alifath/cursor-chat-rtl-persian"
  },
  "homepage": "https://github.com/alifath/cursor-chat-rtl-persian#readme",
  "bugs": {
    "url": "https://github.com/alifath/cursor-chat-rtl-persian/issues"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "arabic",
    "bidi",
    "cursor",
    "cursor-chat",
    "cursor-agent",
    "farsi",
    "hebrew",
    "persian",
    "rtl",
    "rtl-support",
    "agent-chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "cursor-chat-rtl-logo.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursor-rtl-persian.add",
        "title": "Cursor RTL Persian: Activate"
      },
      {
        "command": "cursor-rtl-persian.remove",
        "title": "Cursor RTL Persian: Deactivate"
      },
      {
        "command": "cursor-rtl-persian.status",
        "title": "Cursor RTL Persian: Check Status"
      },
      {
        "command": "cursor-rtl-persian.reapply",
        "title": "Cursor RTL Persian: Re-apply After Cursor Update"
      },
      {
        "command": "cursor-rtl-persian.toggle",
        "title": "Cursor RTL Persian: Toggle"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "compile": "node esbuild.mjs",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
